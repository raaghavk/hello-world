# Server Configuration
PORT=3000
NODE_ENV=production
SESSION_SECRET=change-this-to-a-random-string-min-32-chars

# Database
DATABASE_PATH=./data/uptime.db

# Email Configuration (for sending alerts)
# Use a service like SendGrid, Mailgun, or Gmail
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-specific-password
EMAIL_FROM=noreply@yourmonitor.com

# Stripe Payment Keys
# Get these from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Pricing (in cents)
BASIC_PLAN_PRICE=1000
PRO_PLAN_PRICE=2000

# Monitoring Configuration
CHECK_INTERVAL_SECONDS=300
REQUEST_TIMEOUT_MS=10000

# Admin Configuration
ADMIN_EMAIL=admin@yourmonitor.com
ADMIN_PASSWORD=change-this-secure-password
