# Server Configuration
PORT=3000
NODE_ENV=production
SESSION_SECRET=change-this-to-a-random-string-min-32-chars

# Database
DATABASE_PATH=./data/uptime.db

# Email Configuration (for sending alerts)
# Use a service like SendGrid, Mailgun, or Gmail
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-specific-password
EMAIL_FROM=noreply@yourmonitor.com

# Payment Gateway Configuration
PAYMENT_PROVIDER=razorpay

# Razorpay Payment Keys (PRIMARY for India)
# Get these from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Stripe Payment Keys (OPTIONAL - for international customers)
# Get these from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Pricing (in INR - Indian Rupees)
# These are monthly subscription prices
BASIC_PLAN_PRICE=299
PRO_PLAN_PRICE=599
ENTERPRISE_PLAN_PRICE=1499

# Monitoring Configuration
CHECK_INTERVAL_SECONDS=300
REQUEST_TIMEOUT_MS=10000

# WhatsApp Notifications (CRITICAL for India!)
# Use services like: WATI.io, Interakt, or Twilio WhatsApp
WHATSAPP_ENABLED=true
WHATSAPP_API_URL=https://live-server-xxxx.wati.io/api/v1/sendSessionMessage
WHATSAPP_API_KEY=your_wati_api_key
WHATSAPP_FROM_NUMBER=+919876543210

# Admin Configuration
ADMIN_EMAIL=admin@yourmonitor.com
ADMIN_PASSWORD=change-this-secure-password
